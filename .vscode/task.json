{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Forgewild: Build",
            "type": "shell",
            "command": "sh",
            "args": [
                "${workspaceFolder}/build.sh"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\build.ps1"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Forgewild: Test",
            "type": "shell",
            "command": "sh",
            "args": [
                "${workspaceFolder}/test.sh"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\test.ps1"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": "$msCompile"
        }
    ]
}
